@article{shalev2026pardig,
  title={PARDIG: Global Precipitation Estimates Learned from Sparse Satellite Observations},
  author={Shalev, Guy and Rasp, Stephan and Babenko, Boris and El-Kadi, Andrew and Hassen, Mohammed Alewi and Merchant, Samier and Zyda, Fred and Masters, Dominic and Alet, Ferran and Rühling Cachay, Salva and Price, Ilan and Uddin, Akib and Peled Levi, Nofar and Gaiarin, Ben and Bell, Aaron and Battaglia, Peter and Sanchez-Gonzalez, Alvaro},
  journal={arXiv preprint arXiv:2611.13941},
  year={2026},
  abbr={arXiv},
  abstract={Estimating precipitation at the global scale is vital for Earth system science and disaster response, yet observational coverage and measurement precision remain constrained. Existing solutions provide options that trade off desirable traits such as skill, latency, geographical coverage, temporal coverage, and spatial and temporal resolution. We present PARDIG, an artificial intelligence framework based on a spherical graph-mesh transformer architecture that produces near-real-time global precipitation estimates. PARDIG is trained on dense multi-modal inputs, including atmospheric state analyses and multi-spectral geostationary satellite imagery, to predict sparse, high-precision precipitation measurements from spaceborne radar. At inference, the trained model is applied densely across the globe at 0.1° spatial and 15-minute temporal resolution, producing complete near-real-time precipitation fields from 2016 to the present, alongside a historical variant extending the record back to 1999. Evaluation against three independent radar networks (over the US, Europe, and Japan) and against over 36,000 surface stations worldwide shows that PARDIG consistently outperforms IMERG V07 (Final and Early), MSWEP V3, ERA5, and HRES across precipitation thresholds and regions, with the largest improvements at extreme intensities. Case studies of extreme precipitation events demonstrate that PARDIG successfully captures their spatial structure and timing. The improvements also extend to forecasting: WeatherNext 3, a global weather model, produces more skillful precipitation forecasts when trained to predict PARDIG. Both the historical and near-real-time PARDIG datasets are openly available under a CC BY 4.0 license.},
  url={https://arxiv.org/abs/2611.13941},
  pdf={https://arxiv.org/pdf/2611.13941},
  category={preprint},
  bibtex_show={true},
  selected={false}
}

@article{cachay2021world,
  title={The World as a Graph: Improving El Ni{\~n}o Forecasts with Graph Neural Networks},
  author={Rühling Cachay, Salva and Erickson, Emma and Fender C. Bucker, Arthur and Pokropek, Ernest and Potosnak, Willa and Bire, Suyash and Osei, Salomey and Lütjens, Björn},
  journal={arXiv preprint arXiv:2104.05089},
  year={2021},
  abbr={arXiv},
  abstract={Deep learning-based models have recently outperformed state-of-the-art seasonal forecasting models, such as for predicting El Niño-Southern Oscillation (ENSO). However, current deep learning models are based on convolutional neural networks which are difficult to interpret and can fail to model large-scale atmospheric patterns. In comparison, graph neural networks (GNNs) are capable of modeling large-scale spatial dependencies and are more interpretable due to the explicit modeling of information flow through edge connections. We propose the first application of graph neural networks to seasonal forecasting. We design a novel graph connectivity learning module that enables our GNN model to learn large-scale spatial interactions jointly with the actual ENSO forecasting task. Our model, Graphino, outperforms state-of-the-art deep learning-based models for forecasts up to six months ahead. Additionally, we show that our model is more interpretable as it learns sensible connectivity structures that correlate with the ENSO anomaly pattern.},
  url={https://arxiv.org/abs/2104.05089},
  pdf={https://arxiv.org/pdf/2104.05089},
  code={https://github.com/salvaRC/graphino},
  poster={poster/Graphino.png},
  slides={https://docs.google.com/presentation/d/e/2PACX-1vTt9E0ltCxATjL_zanekINnHttOr68dPypVxs7GZeq8tX-O4BYbY0sMJXZ6UEuLXwdW_n7oQTM8I23g/pub?start=false&loop=false&delayms=3000},
  media={https://ai4edatasetspublicassets.blob.core.windows.net/grantee-profiles/Salva%20Ruhling%20Cachay_EMEA_Climate_AI4E%20Grantee%20Profile_Final.pdf},
  category={preprint},
  bibtex_show={true},
  selected={false}
}

